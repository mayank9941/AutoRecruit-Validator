# Copy this file to .env and fill in YOUR OWN values.
# Each teammate running this backend needs their own .env -- this is what
# lets everyone use their own local Postgres password / Gemini API key
# without having to 'set' environment variables manually every time they
# open a new terminal.

# Your local PostgreSQL connection. Replace YOUR_PASSWORD with whatever
# password YOU set when installing Postgres on YOUR machine (this is very
# likely different for every teammate -- that mismatch is the #1 cause of
# "password authentication failed" errors).
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/ihmcl_hr

# Your own Gemini API key (from Google AI Studio). Each teammate should
# use their own key rather than sharing one.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Used to sign login session cookies. Any long random string works --
# it does NOT need to match between teammates, since each person is
# running their own separate backend + database.
SECRET_KEY=change-this-to-any-long-random-string

# Only needed if your frontend runs somewhere other than the default
# Vite dev server address.
# FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
