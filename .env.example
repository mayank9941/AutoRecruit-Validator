# Copy to `.env` next to docker-compose.yml and fill in real values.
# NEVER commit the real .env.

# Public domain the app is served on (A record must point at the server).
# Caddy uses it to obtain the HTTPS certificate automatically.
DOMAIN=hr.example.com

# --- No domain yet? Plain-HTTP mode (access via http://<server-ip>) ---
# Use these two lines instead of the ones above/below:
#   DOMAIN=:80          # Caddy serves plain http for any host, no TLS
#   COOKIE_SECURE=false # required: Secure cookies don't work over http
# Switch back to a real domain + HTTPS before real candidate data goes in.

# Postgres password (backend connects with user "ihmcl", db "ihmcl_hr").
# Generate: openssl rand -hex 24
DB_PASSWORD=change-me

# Signs the HR session cookies. If this leaks, anyone can forge a login.
# Generate: openssl rand -hex 32
SECRET_KEY=change-me

# Google AI Studio key used for JD parsing, screening, and OCR fallback.
GEMINI_API_KEY=change-me
